# Copy this file to .env and fill in the keys you actually use.
# .env is gitignored. Never commit real keys.

# At least one chat provider is required.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-5
# Optional alias. Used only if ANTHROPIC_API_KEY is empty.
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-opus-5

# Optional per-role model overrides.
DIRECTOR_MODEL=gpt-4.1
DIRECTOR_GEMINI_MODEL=gemini-2.5-pro

# Spoken narration. Hindi needs ElevenLabs. English can use ElevenLabs or Deepgram.
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_TTS_MODEL=aura-2-athena-en
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_EN_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_EN_MODEL=eleven_turbo_v2_5

# Optional. Sora falls back to OPENAI_API_KEY when this is empty.
SORA_API_KEY=your_sora_api_key_here
SORA_MODEL=sora-2
SORA_SECONDS=8
SORA_SIZE=720x1280

# Optional still-image generation (OpenAI).
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=medium

# Optional JSON map of USD per 1M tokens, used only for cost display.
# MODEL_PRICES={"gpt-4o-mini":{"in":0.15,"out":0.60}}
